 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Análisis de Resultados — Detección Colaborativa de Meaconing GNSS\n",
    "\n",
    "**TFM: Arquitectura de Seguridad para Navegación Autónoma de Robots**  \n",
    "Antonio García Alcón — Universidad Europea de Madrid, 2026\n",
    "\n",
    "---\n",
    "\n",
    "Carga automática de rosbags desde `~/tfm_meaconing_ws/results/` y genera:\n",
    "\n",
    "1. Evolución temporal de $S_k$ para cada escenario\n",
    "2. TTD vs drift velocity\n",
    "3. $\Delta(t)$ vs $S(t)$: comparación umbral fijo vs CUSUM\n",
    "\n",
    "> **Requiere ejecutar Jupyter desde el entorno ROS 2 Jazzy** (`rosbag2_py`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%matplotlib inline\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "from collections import defaultdict\n",
    "import os\n",
    "\n",
    "# rosbag2 reader\n",
    "from rosbag2_py import SequentialReader, StorageOptions, ConverterOptions\n",
    "from rclpy.serialization import deserialize_message\n",
    "from rosidl_runtime_py.utilities import get_message\n",
    "\n",
    "plt.rcParams.update({\n",
    "    'figure.dpi': 150,\n",
    "    'font.size': 11,\n",
    "    'axes.titlesize': 14,\n",
    "    'axes.labelsize': 12,\n",
    "})\n",
    "\n",
    "RESULTS_DIR = Path.home() / 'tfm_meaconing_ws' / 'results'\n",
    "print(f'Results directory: {RESULTS_DIR}')\n",
    "print(f'Experiments found: {[d.name for d in sorted(RESULTS_DIR.glob(\"E*\")) if d.is_dir()]}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Carga de datos desde rosbag\n",
    "\n",
    "Carga todas las series temporales de un rosbag2 (formato MCAP)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_rosbag(bag_path: str) -> dict:\n",
    "    \"\"\"Load a rosbag2 (MCAP/SQLite) and extract time series for all topics.\"\"\"\n",
    "    storage_options = StorageOptions(uri=str(bag_path), storage_id='mcap')\n",
    "    converter_options = ConverterOptions(\n",
    "        input_serialization_format='cdr',\n",
    "        output_serialization_format='cdr'\n",
    "    )\n",
    "    \n",
    "    reader = SequentialReader()\n",
    "    reader.open(storage_options, converter_options)\n",
    "    \n",
    "    # Topic type map\n",
    "    type_map = {}\n",
    "    for topic_meta in reader.get_all_topics_and_types():\n",
    "        type_map[topic_meta.name] = topic_meta.type\n",
    "    \n",
    "    print(f'Topics in bag: {list(type_map.keys())}')\n",
    "    \n",
    "    # Store per-topic time series\n",
    "    data = defaultdict(lambda: {'time': [], 'value': []})\n",
    "    t0 = None\n",
    "    \n",
    "    while reader.has_next():\n",
    "        (topic, msg_bytes, timestamp_ns) = reader.read_next()\n",
    "        ts = timestamp_ns / 1e9\n",
    "        \n",
    "        if t0 is None:\n",
    "            t0 = ts\n",
    "        \n",
    "        if topic in type_map:\n",
    "            msg_type = get_message(type_map[topic])\n",
    "            msg = deserialize_message(msg_bytes, msg_type)\n",
    "            \n",
    "            data[topic]['time'].append(ts - t0)\n",
    "            \n",
    "            # Extract value depending on message type\n",
    "            if hasattr(msg, 'data'):\n",
    "                # std_msgs/Float64, std_msgs/Bool\n",
    "                val = msg.data\n",
    "                if isinstance(val, bool):\n",
    "                    val = 1.0 if val else 0.0\n",
    "                data[topic]['value'].append(float(val))\n",
    "            elif hasattr(msg, 'pose') and hasattr(msg.pose, 'position'):\n",
    "                # PoseStamped / Odometry: store x, y\n",
    "                pos = msg.pose.position if hasattr(msg, 'pose') else msg.pose.pose.position\n",
    "                data[topic]['value'].append(pos.x)  # we'll handle y separately if needed\n",
    "            else:\n",
    "                data[topic]['value'].append(0.0)\n",
    "    \n",
    "    # Convert to numpy arrays\n",
    "    result = {}\n",
    "    for topic, d in data.items():\n",
    "        if len(d['time']) > 0:\n",
    "            result[topic] = {\n",
    "                'time': np.array(d['time']),\n",
    "                'value': np.array(d['value'])\n",
    "            }\n",
    "    \n",
    "    print(f'Loaded {sum(len(d[\"time\"]) for d in data.values())} messages across {len(result)} topics')\n",
    "    return result\n",
    "\n",
    "# Load all experiments\n",
    "experiments = {}\n",
    "for exp_dir in sorted(RESULTS_DIR.glob('E*')):\n",
    "    if exp_dir.is_dir():\n",
    "        print(f'\\n--- Loading {exp_dir.name} ---')\n",
    "        experiments[exp_dir.name] = load_rosbag(exp_dir)\n",
    "\n",
    "print(f'\\nLoaded {len(experiments)} experiments.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Diagnóstico: ¿qué topics tienen datos?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for exp_name, data in experiments.items():\n",
    "    topics_with_data = [t for t, d in data.items() if len(d['time']) > 0]\n",
    "    topics_empty = [t for t, d in data.items() if len(d['time']) == 0]\n",
    "    print(f'{exp_name}:')\n",
    "    print(f'  With data: {topics_with_data}')\n",
    "    if topics_empty:\n",
    "        print(f'  Empty:     {topics_empty}')\n",
    "    print()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Evolución temporal de S_k\n",
    "\n",
    "Gráfica del estadístico CUSUM para cada experimento con datos disponibles."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "TAU = 3.0  # Detection threshold\n",
    "\n",
    "fig, axes = plt.subplots(len(experiments), 1, figsize=(14, 3 * len(experiments)), sharex=True)\n",
    "if len(experiments) == 1:\n",
    "    axes = [axes]\n",
    "\n",
    "for ax, (exp_name, data) in zip(axes, experiments.items()):\n",
    "    cusum = data.get('/system/cusum_value')\n",
    "    alert = data.get('/system/meaconing_alert')\n",
    "    delta = data.get('/system/delta_value')\n",
    "    uwb   = data.get('/robots/uwb_distance')\n",
    "    \n",
    "    if cusum and len(cusum['time']) > 0:\n",
    "        ax.plot(cusum['time'], cusum['value'], 'b-', linewidth=1.2, label='$S_k$ (CUSUM)')\n",
    "    if delta and len(delta['time']) > 0:\n",
    "        ax.plot(delta['time'], delta['value'], 'g-', linewidth=0.5, alpha=0.5, label='$\\delta$ (innovation)')\n",
    "    if alert and len(alert['time']) > 0:\n",
    "        alert_mask = alert['value'] > 0.5\n",
    "        if np.any(alert_mask):\n",
    "            ax.fill_between(alert['time'], 0, TAU * 1.5, where=alert_mask,\n",
    "                           alpha=0.2, color='red', label='Alarm active')\n",
    "    \n",
    "    ax.axhline(y=TAU, color='red', linestyle='--', linewidth=1.5, label=f'$\\\\tau$ = {TAU}')\n",
    "    ax.set_ylabel('Value')\n",
    "    ax.set_title(f'{exp_name}')\n",
    "    ax.legend(loc='upper left', fontsize=8)\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    ax.set_ylim(-1, TAU * 2)\n",
    "\n",
    "ax.set_xlabel('Time (s)')\n",
    "plt.tight_layout()\n",
    "plt.savefig(RESULTS_DIR / 'cusum_evolution.png', bbox_inches='tight', dpi=200)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Distancia UWB vs D_GNSS (calculada desde odometría)\n",
    "\n",
    "Compara las dos fuentes de distancia: UWB (física) vs GNSS (desde posiciones).\n",
    "Bajo ataque, D_GNSS colapsa a ~0m mientras D_UWB se mantiene."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_d_gnss_from_odom(odom_a, odom_b):\n",
    "    \"\"\"Compute D_GNSS from two odometry time series (nearest-neighbour sync).\"\"\"\n",
    "    ta, va = odom_a['time'], odom_a['value']\n",
    "    tb, vb = odom_b['time'], odom_b['value']\n",
    "    \n",
    "    # Simple approach: interpolate to common timeline\n",
    "    t_common = np.linspace(max(ta[0], tb[0]), min(ta[-1], tb[-1]), \n",
    "                           min(len(ta), len(tb)))\n",
    "    va_interp = np.interp(t_common, ta, va)\n",
    "    vb_interp = np.interp(t_common, tb, vb)\n",
    "    d_gnss = np.abs(va_interp - vb_interp)  # approximate; full calculation needs x,y\n",
    "    return t_common, d_gnss\n",
    "\n",
    "for exp_name, data in experiments.items():\n",
    "    uwb = data.get('/robots/uwb_distance')\n",
    "    if uwb is None or len(uwb['time']) == 0:\n",
    "        continue\n",
    "    \n",
    "    fig, ax = plt.subplots(figsize=(12, 4))\n",
    "    ax.plot(uwb['time'], uwb['value'], 'b-', linewidth=1.0, alpha=0.8, label='$D_{UWB}$ (physical)')\n",
    "    ax.set_xlabel('Time (s)')\n",
    "    ax.set_ylabel('Distance (m)')\n",
    "    ax.set_title(f'{exp_name} — UWB Distance')\n",
    "    ax.legend()\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Comparación umbral fijo vs CUSUM\n",
    "\n",
    "Muestra la ventaja del detector secuencial frente a un threshold fijo sobre la innovación."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_threshold_vs_cusum(time, delta, S_k, tau=3.0, attack_start=None, title=''):\n",
    "    \"\"\"Compare fixed threshold vs CUSUM on the same data.\"\"\"\n",
    "    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 7), sharex=True)\n",
    "    \n",
    "    # Innovation\n",
    "    ax1.plot(time, delta, linewidth=0.5, color='steelblue', alpha=0.7, label='$\\delta(t)$')\n",
    "    ax1.axhline(y=2.0, color='orange', linestyle='--', linewidth=1.5, label='Fixed thr = 2.0 m')\n",
    "    ax1.set_ylabel('$\\delta(t)$ (m)')\n",
    "    ax1.set_title(f'{title} — Fixed Threshold')\n",
    "    ax1.legend(loc='upper left')\n",
    "    ax1.grid(True, alpha=0.3)\n",
    "    \n",
    "    # CUSUM\n",
    "    ax2.plot(time, S_k, linewidth=1.2, color='darkred', label='$S_k$ (CUSUM)')\n",
    "    ax2.axhline(y=tau, color='red', linestyle='--', linewidth=1.5, label=f'$\\\\tau$ = {tau}')\n",
    "    ax2.fill_between(time, 0, tau, alpha=0.05, color='green')\n",
    "    ax2.fill_between(time, tau, max(S_k)*1.1 if max(S_k) > tau else tau*2, alpha=0.05, color='red')\n",
    "    ax2.set_xlabel('Time (s)')\n",
    "    ax2.set_ylabel('$S_k$')\n",
    "    ax2.set_title(f'{title} — CUSUM Detector')\n",
    "    ax2.legend(loc='upper left')\n",
    "    ax2.grid(True, alpha=0.3)\n",
    "    \n",
    "    if attack_start is not None:\n",
    "        for ax in [ax1, ax2]:\n",
    "            ax.axvline(x=attack_start, color='purple', linestyle=':', linewidth=1.5)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    return fig\n",
    "\n",
    "# Generate for experiments with cusum + delta data\n",
    "for exp_name, data in experiments.items():\n",
    "    cusum = data.get('/system/cusum_value')\n",
    "    delta = data.get('/system/delta_value')\n",
    "    \n",
    "    if cusum and delta and len(cusum['time']) > 0 and len(delta['time']) > 0:\n",
    "        # Align time bases\n",
    "        t_min = min(len(cusum['time']), len(delta['time']))\n",
    "        fig = plot_threshold_vs_cusum(\n",
    "            cusum['time'][:t_min], delta['value'][:t_min], cusum['value'][:t_min],\n",
    "            tau=TAU, title=exp_name\n",
    "        )\n",
    "        plt.show()\n",
    "    else:\n",
    "        print(f'{exp_name}: No CUSUM/delta data available — meaconing_injector likely crashed (see launch log)')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Métricas de detección\n",
    "\n",
    "TTD (Time-To-Detect) y validación de falsos positivos."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_ttd(alert_time, alert_value, cusum_time, cusum_value, tau):\n",
    "    \"\"\"Compute TTD: time from first positive CUSUM drift to threshold crossing.\"\"\"\n",
    "    if len(cusum_value) == 0:\n",
    "        return None\n",
    "    # Find first crossing\n",
    "    crossings = np.where(cusum_value > tau)[0]\n",
    "    if len(crossings) == 0:\n",
    "        return None  # Never detected\n",
    "    return cusum_time[crossings[0]]\n",
    "\n",
    "print('Experiment  |  TTD (s)  |  False Alarms')\n",
    "print('-' * 45)\n",
    "for exp_name, data in experiments.items():\n",
    "    cusum = data.get('/system/cusum_value')\n",
    "    alert = data.get('/system/meaconing_alert')\n",
    "    \n",
    "    if cusum and len(cusum['time']) > 0:\n",
    "        ttd = compute_ttd(cusum['time'], cusum['value'], \n",
    "                         cusum['time'], cusum['value'], TAU)\n",
    "        \n",
    "        # Count false alarms (before attack, t < 30s)\n",
    "        if alert and len(alert['time']) > 0:\n",
    "            pre_attack = alert['time'] < 30\n",
    "            n_false = np.sum(alert['value'][pre_attack] > 0.5)\n",
    "        else:\n",
    "            n_false = 0\n",
    "        \n",
    "        ttd_str = f'{ttd:.2f}s' if ttd is not None else 'N/A'\n",
    "        print(f'{exp_name:<14} {ttd_str:<10} {n_false}')\n",
    "    else:\n",
    "        print(f'{exp_name:<14} {\"NO DATA\":<10} —')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## Experimentos\n",
    "\n",
    "| Escenario | Ataque | Objetivo |\n",
    "|---|---|---|\n",
    "| E0 — Baseline | Sin ataque | Validar 0 falsos positivos |\n",
    "| E1 — Meaconing lento | drift 0.1 m/s | Medir TTD para ataque sutil |\n",
    "| E2 — Meaconing rápido | drift 0.5 m/s | Medir TTD para ataque obvio |\n",
    "| E3 — Arranque en caliente | Ataque desde t=0 | Medir TTD desde estado atacado |\n",
    "| E4 — Separación amplia | 5m entre robots | ¿Afecta la separación al TTD? |\n",
    "\n",
    "---\n",
    "\n",
    "*Notebook generado para el TFM de Antonio García Alcón — Universidad Europea de Madrid, 2026.*"
   ]
  }
